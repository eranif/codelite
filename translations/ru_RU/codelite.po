msgstr "Имя элемента управления"

#: wxcrafter/wxCrafterCommon/controls/timer_wrapper.cpp:19
msgid "Sets the current interval for the timer (in milliseconds)"
msgstr "Устанавливает текущий интервал таймера (в миллисекундах)"

#: wxcrafter/wxCrafterCommon/controls/timer_wrapper.cpp:20
#: wxcrafter/wxCrafterCommon/src/wxgui_defs.h:252
msgid "Start the timer"
msgstr "Запустить таймер"

#: wxcrafter/wxCrafterCommon/controls/timer_wrapper.cpp:23
