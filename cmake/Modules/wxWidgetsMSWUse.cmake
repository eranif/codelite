# Replaces the file that was generated by wx-config on Windows. It is included by the sub-projects (via
# ${wxWidgets_USE_FILE}) after the top level CMakeLists.txt found wxWidgets using find_package(wxWidgets CONFIG).
# Link against wxWidgets using ${wxWidgets_LIBRARIES}

foreach(_wx_lib ${wxWidgets_LIBRARIES})
  if(TARGET ${_wx_lib})
    get_target_property(_wx_includes ${_wx_lib} INTERFACE_INCLUDE_DIRECTORIES)
    if(_wx_includes)
      include_directories(${_wx_includes})
    endif()
  endif()
endforeach()

add_definitions(-Wno-ignored-attributes)
add_definitions(-Wno-unknown-pragmas)
add_definitions(-Wno-unused-private-field)
add_definitions(-D_FILE_OFFSET_BITS=64)
add_definitions(-DWXUSINGDLL)
add_definitions(-D__WXMSW__)
add_definitions(-DHAVE_W32API_H)
add_definitions(-D_UNICODE)
add_definitions(-fmessage-length=0)
add_definitions(-pipe)
add_definitions(-DwxDEBUG_LEVEL=0)
