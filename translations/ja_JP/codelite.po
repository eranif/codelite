#: wxcrafter/wxCrafterCommon/top_level_windows/AuiToolBarTopLevel.cpp:44
#: wxcrafter/wxCrafterCommon/top_level_windows/image_list_wrapper.cpp:18
msgid "The generated C++ class name"
msgstr "生成する C++ のクラス名"

#: wxcrafter/wxCrafterCommon/controls/top_level_win_wrapper.cpp:120
msgid "You did not set the 'Inherited C++ Class Properties -> File name' property for the top level window: '"
msgstr "トップレベルウィンドウに対して '[継承した C++ クラスのプロパティ] -> [ファイル名]' を設定していません: '"

#: wxcrafter/wxCrafterCommon/controls/top_level_win_wrapper.cpp:123
msgid ""
"This means that only base class code will be generated\n"
