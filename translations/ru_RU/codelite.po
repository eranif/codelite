msgstr "Разовый таймер — определяет, будет ли событие таймера вызываться многократно или только один раз"

#: wxcrafter/wxCrafterCommon/controls/timer_wrapper.cpp:24
msgid "Process a timer event"
msgstr "Обрабатывать событие таймера"

#: wxcrafter/wxCrafterCommon/controls/top_level_win_wrapper.cpp:35
