msgstr "Обрабатывать события перемещения на страницу вверх wxEVT_SCROLL_PAGEUP."

#: wxcrafter/wxCrafterCommon/controls/scroll_bar_wrapper.cpp:25
#: wxcrafter/wxCrafterCommon/controls/slider_wrapper.cpp:38
msgid "Process wxEVT_SCROLL_PAGEDOWN page down events"
msgstr "Обрабатывать события перемещения на страницу вниз wxEVT_SCROLL_PAGEDOWN."

#: wxcrafter/wxCrafterCommon/controls/scroll_bar_wrapper.cpp:28
#: wxcrafter/wxCrafterCommon/controls/slider_wrapper.cpp:41
msgid "Process wxEVT_SCROLL_THUMBTRACK thumbtrack events (frequent events sent as the user drags the thumbtrack)."
msgstr "Обрабатывать события перемещения ползунка wxEVT_SCROLL_THUMBTRACK (частые события, отправляемые при перетаскивании пользователем ползунка полосы прокрутки)."

#: wxcrafter/wxCrafterCommon/controls/scroll_bar_wrapper.cpp:32
#: wxcrafter/wxCrafterCommon/controls/slider_wrapper.cpp:45
