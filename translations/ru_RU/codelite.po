#: wxcrafter/wxCrafterCommon/controls/scroll_bar_wrapper.cpp:20
#: wxcrafter/wxCrafterCommon/controls/slider_wrapper.cpp:33
msgid "Process wxEVT_SCROLL_LINEUP line up events."
msgstr "Обрабатывать события перемещения на строку вверх wxEVT_SCROLL_LINEUP."

#: wxcrafter/wxCrafterCommon/controls/scroll_bar_wrapper.cpp:22
#: wxcrafter/wxCrafterCommon/controls/slider_wrapper.cpp:35
