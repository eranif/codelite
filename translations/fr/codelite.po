msgid "Respond to wxEVT_PG_ITEM_COLLAPSED event, generated when user collapses a property or category."
msgstr "Répond à l'événement 'wxEVT_PG_ITEM_COLLAPSED', généré lorsque l'utilisateur réduit une propriété ou une catégorie."

